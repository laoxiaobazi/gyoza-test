---
interface Props {
  eyebrow: string
  title: string
  description?: string
}

const { eyebrow, title, description } = Astro.props
---

<div class="mb-10" data-reveal>
  <div class="text-xs md:text-sm font-bold uppercase tracking-[0.2em] text-accent mb-3">
    {eyebrow}
  </div>
  <h2 class="text-3xl md:text-4xl font-bold">{title}</h2>
  {description && <p class="mt-4 text-secondary max-w-[640px]">{description}</p>}
</div>
