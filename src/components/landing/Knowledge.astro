---
import SectionHeading from './SectionHeading.astro'
import { landing } from '@/config.json'

const { knowledge } = landing
---

<section id="knowledge" class="max-w-[1100px] mx-auto px-4 md:px-8 py-16 md:py-24">
  <SectionHeading eyebrow={knowledge.eyebrow} title={knowledge.title} description={knowledge.description} />
  <div class="grid md:grid-cols-2 gap-5">
    {
      knowledge.items.map((item) => (
        <a
          href={item.link || '#knowledge'}
          class:list={[
            'group flex gap-5 rounded-2xl border border-[#191A1D]/20 dark:border-white/20 p-6 transition-all hover:border-[#191A1D]/60 dark:hover:border-white/60 hover:-translate-y-1',
            !item.link && 'pointer-events-none opacity-80',
          ]}
          data-reveal
        >
          <span class="shrink-0 text-2xl font-bold text-accent/60 font-['Atkinson']">
            {item.index}
          </span>
          <div class="min-w-0">
            <h3 class="text-lg font-bold">{item.name}</h3>
            <p class="mt-2 text-sm text-secondary leading-relaxed">{item.summary}</p>
            {
              item.link && (
                <span class="inline-flex items-center gap-1 mt-4 text-sm text-accent">
                  {item.linkText}
                  <i class="iconfont icon-right group-hover:translate-x-0.5 transition-transform" />
                </span>
              )
            }
          </div>
        </a>
      ))
    }
  </div>
</section>
