---
import SectionHeading from './SectionHeading.astro'
import { landing } from '@/config.json'

const { journey } = landing
---

<section id="journey" class="max-w-[1100px] mx-auto px-4 md:px-8 py-16 md:py-24">
  <SectionHeading eyebrow={journey.eyebrow} title={journey.title} description={journey.description} />
  <div class="relative">
    <div class="absolute left-[7px] md:left-[9px] top-2 bottom-2 w-px bg-primary" aria-hidden />
    <ul class="space-y-10">
      {
        journey.items.map((item) => (
          <li class="relative pl-10" data-reveal>
            <span
              class="absolute left-0 top-1.5 size-[15px] rounded-full border-2 border-accent bg-primary"
              aria-hidden
            />
            <div class="text-sm text-secondary font-['Atkinson']">{item.time}</div>
            <h3 class="mt-1 text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-sm text-secondary leading-relaxed max-w-[640px]">{item.summary}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {item.tags.map((tag) => (
                <span class="rounded-full bg-secondary px-3 py-1 text-xs text-secondary">
                  {tag}
                </span>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
