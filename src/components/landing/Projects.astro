---
import SectionHeading from './SectionHeading.astro'
import { ProductShowcase } from './ProductShowcase'
import { landing } from '@/config.json'

const { projects } = landing
---

<section id="projects" class="max-w-[1100px] mx-auto px-4 md:px-8 py-16 md:py-24">
  <SectionHeading eyebrow={projects.eyebrow} title={projects.title} description={projects.description} />
  <ProductShowcase client:visible {...projects} />
</section>

<style is:global>
  .terminal-caret {
    animation: terminal-caret-blink 1s step-end infinite;
  }

  @keyframes terminal-caret-blink {
    50% {
      opacity: 0;
    }
  }
</style>
