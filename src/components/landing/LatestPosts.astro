---
import type { CollectionEntry } from 'astro:content'
import { getShortDate } from '@/utils/date'
import { withBase } from '@/utils/base'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<section class="max-w-[1100px] mx-auto px-4 md:px-8 py-16 md:py-24">
  <div class="mb-10" data-reveal>
    <div class="text-xs md:text-sm font-bold uppercase tracking-[0.2em] text-accent mb-3">BLOG</div>
    <h2 class="text-3xl md:text-4xl font-bold">最新文章</h2>
  </div>
  <ul class="divide-y divide-primary border-y border-primary" data-reveal>
    {
      posts.map((post) => (
        <li>
          <a
            href={withBase(`/posts/${post.slug}`)}
            class="group flex items-baseline gap-4 py-4 hover:text-accent transition-colors"
          >
            <span class="shrink-0 text-sm text-secondary font-['Atkinson']">
              {getShortDate(post.data.date)}
            </span>
            <span class="font-medium">{post.data.title}</span>
            <i class="iconfont icon-right ml-auto opacity-0 group-hover:opacity-100 transition-opacity" />
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mt-6 text-right" data-reveal>
    <a href={withBase('/posts')} class="inline-flex items-center gap-1 text-sm text-accent hover:underline underline-offset-4">
      查看全部文章
      <i class="iconfont icon-right" />
    </a>
  </div>
</section>
