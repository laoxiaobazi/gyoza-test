---
import type { Block } from '@/data/projects'
import { withBase } from '@/utils/base'

interface Props {
  block: Block
}
const { block } = Astro.props

// 灯箱：把图片用 data-lb 锚点包起来（dialog 灯箱在 ProjectDetail 里统一处理）
function zoom(src: string, title: string) {
  return {
    href: withBase(src),
    'data-lb': true,
    'data-lb-src': withBase(src),
    'data-lb-title': title,
  }
}
---

{
  block.type === 'paragraph' && (
    <p class="text-secondary leading-loose">{block.body}</p>
  )
}

{
  block.type === 'image-text' && (
    <div
      class={`mt-8 flex flex-col gap-5 items-start md:flex-row ${block.imageSide === 'right' ? 'md:flex-row-reverse' : ''}`}
    >
      <figure class="w-full md:w-1/2">
        <a {...zoom(block.image, block.alt)} class="lb-anchor block">
          <img
            src={withBase(block.image)}
            alt={block.alt}
            class="w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
          />
        </a>
        {block.caption && (
          <figcaption class="mt-2 text-xs text-secondary">{block.caption}</figcaption>
        )}
      </figure>
      <div class="w-full md:w-1/2">
        <p class="text-secondary leading-loose">{block.body}</p>
      </div>
    </div>
  )
}

{
  block.type === 'video-text' && (
    <div class="mt-8">
      <figure>
        {block.mediaType === 'video' ? (
          <video
            src={withBase(block.media)}
            controls
            class="w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
          />
        ) : (
          <a {...zoom(block.media, block.caption || '视频 / GIF')} class="lb-anchor block">
            <img
              src={withBase(block.media)}
              alt={block.caption || '视频 / GIF'}
              class="w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
            />
          </a>
        )}
        {block.caption && (
          <figcaption class="mt-2 text-xs text-secondary">{block.caption}</figcaption>
        )}
      </figure>
      <p class="mt-4 text-secondary leading-loose">{block.body}</p>
    </div>
  )
}

{
  block.type === 'run-it' && (
    <figure class="mt-8">
      <div class="relative overflow-hidden rounded-2xl border border-[#191A1D]/10 bg-[#EFEEE8] dark:border-white/10 dark:bg-[#25232E]">
        {block.mediaType === 'video' ? (
          <video src={withBase(block.media)} controls class="w-full" />
        ) : (
          <a {...zoom(block.media, block.caption || 'Run it')} class="lb-anchor block">
            <img src={withBase(block.media)} alt={block.caption || 'Run it'} class="w-full" />
          </a>
        )}
        {block.mediaType !== 'video' && (
          <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <span class="flex size-14 items-center justify-center rounded-full bg-white/85 text-lg text-accent backdrop-blur dark:bg-black/40">
              ▶
            </span>
          </span>
        )}
      </div>
      {block.caption && (
        <figcaption class="mt-2 text-xs text-secondary">
          <span class="text-accent">▶ </span>
          {block.caption}
        </figcaption>
      )}
    </figure>
  )
}

{
  block.type === 'gallery' && (
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      {
        block.images.map((img) => (
          <figure>
            <a {...zoom(img.src, img.alt)} class="lb-anchor block">
              <img
                src={withBase(img.src)}
                alt={img.alt}
                class="w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
              />
            </a>
            {img.caption && (
              <figcaption class="mt-1.5 text-xs text-secondary">{img.caption}</figcaption>
            )}
          </figure>
        ))
      }
    </div>
  )
}

{
  block.type === 'before-after' && (
    <div class="mt-8 cmp-wrap">
      <div class="cmp-head">
        {block.caption && <p class="cmp-title">{block.caption}</p>}
        <div class="live-steps cmp-steps">
          <button type="button" class="cmp-btn is-active" data-ba="before">
            <b>{block.beforeLabel || 'Before'}</b>
            <span class="cmp-cap">{block.beforeCap}</span>
          </button>
          <button type="button" class="cmp-btn" data-ba="after">
            <b>{block.afterLabel || 'After'}</b>
            <span class="cmp-cap">{block.afterCap}</span>
          </button>
        </div>
      </div>
      <div class="ba-stage mt-4">
        <a {...zoom(block.before, block.beforeCap || 'Before')} class="lb-anchor block">
          <img
            class="ba-img w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
            data-before={withBase(block.before)}
            data-after={withBase(block.after)}
            src={withBase(block.before)}
            alt={block.beforeCap || 'Before'}
          />
        </a>
      </div>
    </div>
  )
}
