---
import type { Block } from '@/data/projects'
import { withBase } from '@/utils/base'

interface Props {
  block: Block
}
const { block } = Astro.props
---

{
  block.type === 'paragraph' && (
    <p class="text-secondary leading-loose">{block.body}</p>
  )
}

{
  block.type === 'image-text' && (
    <div
      class={`mt-8 flex flex-col gap-5 items-start md:flex-row ${block.imageSide === 'right' ? 'md:flex-row-reverse' : ''}`}
    >
      <figure class="w-full md:w-1/2">
        <img
          src={withBase(block.image)}
          alt={block.alt}
          class="w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
        />
        {block.caption && (
          <figcaption class="mt-2 text-xs text-secondary">{block.caption}</figcaption>
        )}
      </figure>
      <div class="w-full md:w-1/2">
        <p class="text-secondary leading-loose">{block.body}</p>
      </div>
    </div>
  )
}

{
  block.type === 'video-text' && (
    <div class="mt-8">
      <figure>
        {block.mediaType === 'video' ? (
          <video
            src={withBase(block.media)}
            controls
            class="w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
          />
        ) : (
          <img
            src={withBase(block.media)}
            alt={block.caption || '视频 / GIF'}
            class="w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
          />
        )}
        {block.caption && (
          <figcaption class="mt-2 text-xs text-secondary">{block.caption}</figcaption>
        )}
      </figure>
      <p class="mt-4 text-secondary leading-loose">{block.body}</p>
    </div>
  )
}

{
  block.type === 'run-it' && (
    <figure class="mt-8">
      <div class="relative overflow-hidden rounded-2xl border border-[#191A1D]/10 bg-[#EFEEE8] dark:border-white/10 dark:bg-[#25232E]">
        {block.mediaType === 'video' ? (
          <video src={withBase(block.media)} controls class="w-full" />
        ) : (
          <img src={withBase(block.media)} alt={block.caption || 'Run it'} class="w-full" />
        )}
        {block.mediaType !== 'video' && (
          <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <span class="flex size-14 items-center justify-center rounded-full bg-white/85 text-lg text-accent backdrop-blur dark:bg-black/40">
              ▶
            </span>
          </span>
        )}
      </div>
      {block.caption && (
        <figcaption class="mt-2 text-xs text-secondary">
          <span class="text-accent">▶ </span>
          {block.caption}
        </figcaption>
      )}
    </figure>
  )
}

{
  block.type === 'gallery' && (
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      {block.images.map((img) => (
        <figure>
          <img
            src={withBase(img.src)}
            alt={img.alt}
            class="w-full rounded-xl border border-[#191A1D]/10 dark:border-white/10"
          />
          {img.caption && (
            <figcaption class="mt-1.5 text-xs text-secondary">{img.caption}</figcaption>
          )}
        </figure>
      ))}
    </div>
  )
}
